rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function casa(id) { return get(/databases/$(database)/documents/casas/$(id)).data; }
    function membro(id) { return logado() && request.auth.uid in casa(id).membros; }

    // Cada conta guarda só a qual casa pertence
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Códigos de convite: qualquer pessoa logada pode consultar um código específico (não listar)
    match /codigos/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado() && request.auth.uid in casa(request.resource.data.casaId).membros;
      allow update, delete: if false;
    }

    // Aparelhos que recebem lembretes: cada conta só mexe nos próprios.
    // O envio é feito pelo servidor (GitHub Actions), que usa a conta de serviço e não passa por estas regras.
    match /dispositivos/{id} {
      allow read, delete: if logado() && resource.data.uid == request.auth.uid;
      allow create: if logado() && request.resource.data.uid == request.auth.uid
                    && request.auth.uid in casa(request.resource.data.casaId).membros;
      allow update: if logado() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.auth.uid in casa(request.resource.data.casaId).membros;
    }

    match /casas/{casaId} {
      allow read: if logado() && request.auth.uid in resource.data.membros;
      allow create: if logado() && request.resource.data.membros == [request.auth.uid];
      // Membros editam tudo; quem tem o código só pode se adicionar à lista de membros
      allow update: if logado() && (
        request.auth.uid in resource.data.membros ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros']) &&
          request.resource.data.membros.hasAll(resource.data.membros) &&
          request.resource.data.membros.size() == resource.data.membros.size() + 1 &&
          request.auth.uid in request.resource.data.membros
        )
      );
      allow delete: if logado() && request.auth.uid == resource.data.dono;

      // Semanas, meses e backups: só membros da casa
      match /{sub=**} {
        allow read, write: if membro(casaId);
      }
    }
  }
}
